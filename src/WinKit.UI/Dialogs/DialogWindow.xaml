<Window x:Class="WinKit.UI.Dialogs.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        SizeToContent="Height" Width="420" Background="Transparent">

    <Border Background="{DynamicResource Brush.SurfaceElevated}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
            CornerRadius="{DynamicResource Theme.CornerRadius}"
            Padding="24" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource Text.Heading}"/>
            <TextBlock x:Name="MessageText" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0"/>

            <Expander x:Name="DetailsExpander" Header="Technical details" Margin="0,14,0,0"
                      Foreground="{DynamicResource Brush.TextMuted}" Visibility="Collapsed">
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="{DynamicResource Theme.CornerRadiusSmall}"
                        Padding="10" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock x:Name="DetailsText" Style="{StaticResource Text.Muted}"
                                   FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" MaxHeight="140"/>
                        <Button x:Name="CopyButton" Content="Copy details" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0"
                                FontSize="{DynamicResource Font.Size.Small}" Click="OnCopyDetailsClick"/>
                    </StackPanel>
                </Border>
            </Expander>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource Button.Secondary}"
                        Padding="16,8" Margin="0,0,10,0" Click="OnCancelClick"/>
                <Button x:Name="ConfirmButton" Content="Confirm" Style="{StaticResource Button.Primary}"
                        Padding="16,8" Click="OnConfirmClick" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
