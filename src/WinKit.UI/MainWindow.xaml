<Window x:Class="WinKit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:WinKit.UI.ViewModels"
        xmlns:views="clr-namespace:WinKit.UI.Views"
        Title="WinKit" Height="760" Width="1180" MinHeight="560" MinWidth="880"
        Icon="pack://application:,,,/Assets/Icon/WinKit.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                             CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OnboardingViewModel}">
            <views:OnboardingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemToolsViewModel}">
            <views:SystemToolsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkToolsViewModel}">
            <views:NetworkToolsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
            <views:CleanupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <views:DiagnosticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotificationHostViewModel}">
            <views:NotificationHostView/>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource Brush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/Icon/icon-64.png" Width="22" Height="22"
                       Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="WinKit" Style="{StaticResource Text.Base}" FontWeight="SemiBold"
                           FontSize="{DynamicResource Font.Size.Small}" Foreground="{DynamicResource Brush.TextSecondary}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="OnMinimizeClick">
                    <Path Style="{StaticResource Icon.Path}" Width="11" Height="11" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          Data="{StaticResource Icon.Minimize}"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="OnMaximizeRestoreClick">
                    <Path x:Name="MaximizeIcon" Style="{StaticResource Icon.Path}" Width="11" Height="11" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          Data="{StaticResource Icon.Maximize}"/>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CaptionButtonClose}" Click="OnCloseClick">
                    <Path Style="{StaticResource Icon.Path}" Width="11" Height="11" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          Data="{StaticResource Icon.Close}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Full-window onboarding takeover (no sidebar chrome) -->
        <ContentControl Grid.Row="1" Content="{Binding ActiveOnboarding}"
                        Visibility="{Binding ActiveOnboarding, Converter={StaticResource NullToVisibilityConverter}}"/>

        <!-- Body -->
        <Grid Grid.Row="1" Visibility="{Binding ShowChrome, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource Theme.SidebarWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="18,10,18,18">
                        <TextBlock Text="WinKit" Style="{StaticResource Text.Heading}"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding NavItems}" Margin="10,0,10,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItem}">
                                <ContentControl Focusable="{Binding IsSelectable}"
                                                 IsTabStop="{Binding IsSelectable}"
                                                 AutomationProperties.Name="{Binding Title}">
                                    <ContentControl.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        <KeyBinding Key="Space" Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    </ContentControl.InputBindings>
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ContentControl">
                                                        <Border Background="Transparent" Margin="0,3,0,0" CornerRadius="{DynamicResource Theme.CornerRadius}"
                                                                Cursor="Hand" Padding="10,9"
                                                                x:Name="Row">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                              CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="3"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border x:Name="SelectedBar" Grid.Column="0" Width="3" CornerRadius="1.5"
                                                                        Background="{DynamicResource Brush.Accent}" Opacity="0" Margin="-10,-9,0,-9"/>
                                                                <Path Grid.Column="1" Style="{StaticResource Icon.Path}" Margin="0,0,10,0"
                                                                      Width="16" Height="16"
                                                                      Data="{Binding Glyph, Converter={StaticResource ResourceKeyToGeometryConverter}}"
                                                                      Stroke="{DynamicResource Brush.TextSecondary}" x:Name="IconPath"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Brush.TextSecondary}" x:Name="Label"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="SelectedBar" Property="Opacity" Value="1"/>
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
                                                                <Setter TargetName="IconPath" Property="Stroke" Value="{DynamicResource Brush.Accent}"/>
                                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ContentControl">
                                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Muted}"
                                                                           Margin="10,18,0,6" FontWeight="SemiBold"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1" Margin="0">
                <ContentControl Content="{Binding CurrentViewModel}"/>
                <ContentControl Content="{Binding NotificationHost}" IsTabStop="False"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
