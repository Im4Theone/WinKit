<UserControl x:Class="WinKit.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinKit.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:AboutViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <StackPanel Margin="28,22,28,20" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="WinKit" Style="{StaticResource Text.Display}"/>
        <TextBlock Text="{Binding Version, StringFormat=Version {0}}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,20"/>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="A lightweight Windows toolkit for system information, diagnostics, cleanup, and networking."
                           Style="{StaticResource Text.Base}" TextWrapping="Wrap"/>
                <TextBlock Text="Every action WinKit takes is a real, explainable operation — no fake optimizations, no invented performance claims."
                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Privacy" Style="{StaticResource Text.Title}" Margin="0,0,0,8"/>
                <TextBlock Text="No account required. No backend. No telemetry by default. No permanent background process."
                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
