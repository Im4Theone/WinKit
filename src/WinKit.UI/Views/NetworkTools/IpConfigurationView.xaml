<UserControl x:Class="WinKit.UI.Views.NetworkTools.IpConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinKit.UI.ViewModels.NetworkTools"
             xmlns:models="clr-namespace:WinKit.Network.Models;assembly=WinKit.Network"
             d:DataContext="{d:DesignInstance vm:IpConfigurationViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <DockPanel>
        <Button DockPanel.Dock="Top" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}"
                Padding="14,7" HorizontalAlignment="Right" Margin="0,0,0,12"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Adapters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:AdapterConfiguration}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Text.Title}"/>
                                    <Border Grid.Column="1" CornerRadius="10" Padding="8,3"
                                            Background="{DynamicResource Brush.SurfaceElevated}">
                                        <TextBlock Style="{StaticResource Text.Muted}">
                                            <Run Text="{Binding IsUp, Mode=OneWay, Converter={StaticResource ConnectedTextConverter}}"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="0,2,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="IPv4" Style="{StaticResource Text.Muted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding IPv4Addresses, Converter={StaticResource FirstOrPlaceholderConverter}}" Style="{StaticResource Text.Base}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="MAC address" Style="{StaticResource Text.Muted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MacAddress}" Style="{StaticResource Text.Base}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Gateway" Style="{StaticResource Text.Muted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Gateways, Converter={StaticResource FirstOrPlaceholderConverter}}" Style="{StaticResource Text.Base}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DHCP" Style="{StaticResource Text.Muted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DhcpEnabled}" Style="{StaticResource Text.Base}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
