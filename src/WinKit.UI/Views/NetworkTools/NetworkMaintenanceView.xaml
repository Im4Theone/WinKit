<UserControl x:Class="WinKit.UI.Views.NetworkTools.NetworkMaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinKit.UI.ViewModels.NetworkTools"
             d:DataContext="{d:DesignInstance vm:NetworkMaintenanceViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Style x:Key="MaintenanceCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Width" Value="230"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
    </UserControl.Resources>

    <WrapPanel>
        <Border Style="{StaticResource MaintenanceCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Flush DNS" Style="{StaticResource Text.Title}"/>
                    <TextBlock Text="Clear the local DNS resolver cache." Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Row="1" Content="Run" Command="{Binding FlushDnsCommand}" Style="{StaticResource Button.Secondary}"
                        Padding="14,7" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
        <Border Style="{StaticResource MaintenanceCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="DHCP Renew" Style="{StaticResource Text.Title}"/>
                    <TextBlock Text="Request a new IP address lease." Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Row="1" Content="Run" Command="{Binding DhcpRenewCommand}" Style="{StaticResource Button.Secondary}"
                        Padding="14,7" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
        <Border Style="{StaticResource MaintenanceCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="DHCP Release" Style="{StaticResource Text.Title}"/>
                    <TextBlock Text="Release your current IP address lease." Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Row="1" Content="Run" Command="{Binding DhcpReleaseCommand}" Style="{StaticResource Button.Destructive}"
                        Padding="14,7" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
        <Border Style="{StaticResource MaintenanceCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Winsock Reset" Style="{StaticResource Text.Title}"/>
                    <TextBlock Text="Reset the Windows network stack." Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Row="1" Content="Run" Command="{Binding ResetWinsockCommand}" Style="{StaticResource Button.Destructive}"
                        Padding="14,7" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
        <Border Style="{StaticResource MaintenanceCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="TCP/IP Reset" Style="{StaticResource Text.Title}"/>
                    <TextBlock Text="Reset TCP/IP to its default configuration." Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Row="1" Content="Run" Command="{Binding ResetTcpIpCommand}" Style="{StaticResource Button.Destructive}"
                        Padding="14,7" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </WrapPanel>
</UserControl>
