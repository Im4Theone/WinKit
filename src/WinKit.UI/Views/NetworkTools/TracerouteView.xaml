<UserControl x:Class="WinKit.UI.Views.NetworkTools.TracerouteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinKit.UI.ViewModels.NetworkTools"
             xmlns:models="clr-namespace:WinKit.Network.Models;assembly=WinKit.Network"
             d:DataContext="{d:DesignInstance vm:TracerouteViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBox Width="260" Padding="10,7" Margin="0,0,8,0" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding RunCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="Trace" Command="{Binding RunCommand}" Style="{StaticResource Button.Primary}" Padding="16,7" Margin="0,0,8,0"
                    Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
            <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource Button.Secondary}" Padding="16,7"
                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="0">
            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Hops}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:TracerouteHop}">
                            <Grid Margin="16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding HopNumber}" Style="{StaticResource Text.Muted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Address}" Style="{StaticResource Text.Base}"/>
                                <TextBlock Grid.Column="2" Text="{Binding HostName}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding RoundTripTimeMs, StringFormat={}{0}ms}" Style="{StaticResource Text.Base}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
