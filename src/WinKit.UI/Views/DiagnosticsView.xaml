<UserControl x:Class="WinKit.UI.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinKit.UI.ViewModels"
             xmlns:core="clr-namespace:WinKit.Core.Models;assembly=WinKit.Core"
             d:DataContext="{d:DesignInstance vm:DiagnosticsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <DockPanel Margin="28,22,28,20">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="System Diagnostics" Style="{StaticResource Text.Display}"/>
                <TextBlock Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                            <Setter Property="Text" Value="Checking your system..."/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                    <Setter Property="Text" Value="{Binding IssueCount, StringFormat={}{0} issue(s) found}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Content="Run Diagnostics" Command="{Binding RunCommand}" Style="{StaticResource Button.Primary}" Padding="16,8" VerticalAlignment="Top"/>
        </Grid>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16" MaxWidth="700" HorizontalAlignment="Left"
                Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                            <Setter Property="Text" Value="No issues found. Your system is running normally."/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHealthy}" Value="False">
                                    <Setter Property="Text" Value="{Binding IssueCount, StringFormat={}{0} issue(s) require attention}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Content="Review Issues" Command="{Binding ReviewIssuesCommand}" Style="{StaticResource Button.Secondary}" Padding="14,7"
                        Visibility="{Binding IsHealthy, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Results}" MaxWidth="700" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:DiagnosticCheckResult}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,12,0" VerticalAlignment="Center"
                                             Fill="{Binding Status, Converter={StaticResource DiagnosticStatusToBrushConverter}}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Title}"/>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding RecommendedAction}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"
                                                   Visibility="{Binding RecommendedAction, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
