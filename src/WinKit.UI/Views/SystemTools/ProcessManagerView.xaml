<UserControl x:Class="WinKit.UI.Views.SystemTools.ProcessManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinKit.UI.ViewModels.SystemTools"
             xmlns:models="clr-namespace:WinKit.SystemTools.Models;assembly=WinKit.SystemTools"
             xmlns:behaviors="clr-namespace:WinKit.UI.Behaviors"
             d:DataContext="{d:DesignInstance vm:ProcessManagerViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Processes.Count, StringFormat={}{0} processes}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{Binding FreezeButtonText}" Command="{Binding ToggleFreezeCommand}" Style="{StaticResource Button.Secondary}" Padding="14,7"/>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <ListView ItemsSource="{Binding Processes}" SelectionMode="Single" behaviors:GridViewSort.AutoSort="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}"
                                             behaviors:GridViewSort.PropertyName="Name"/>
                            <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Id}"
                                             behaviors:GridViewSort.PropertyName="Id"/>
                            <GridViewColumn Header="CPU" Width="70" behaviors:GridViewSort.PropertyName="CpuPercent">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:ProcessEntry}">
                                        <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Memory" Width="100" behaviors:GridViewSort.PropertyName="WorkingSetBytes">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:ProcessEntry}">
                                        <TextBlock Text="{Binding WorkingSetBytes, Converter={StaticResource BytesToReadableConverter}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Path" Width="300" DisplayMemberBinding="{Binding FilePath}"
                                             behaviors:GridViewSort.PropertyName="FilePath"/>
                            <GridViewColumn Header="" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:ProcessEntry}">
                                        <Button Content="End" Style="{StaticResource Button.Destructive}" Padding="10,4"
                                                FontSize="{DynamicResource Font.Size.Small}"
                                                IsEnabled="{Binding CanBeEnded}"
                                                Command="{Binding DataContext.EndProcessCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
