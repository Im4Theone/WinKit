<UserControl x:Class="WinKit.UI.Views.SystemTools.EnvironmentVariablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinKit.UI.ViewModels.SystemTools"
             xmlns:models="clr-namespace:WinKit.SystemTools.Models;assembly=WinKit.SystemTools"
             xmlns:behaviors="clr-namespace:WinKit.UI.Behaviors"
             d:DataContext="{d:DesignInstance vm:EnvironmentVariablesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="180" Padding="8,6" Margin="0,0,8,0" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Name" ToolTip="Variable name"/>
                <TextBox Width="260" Padding="8,6" Margin="0,0,8,0" Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Value"/>
                <ComboBox Width="100" Margin="0,0,8,0" ItemsSource="{Binding Scopes}" SelectedItem="{Binding NewScope}"/>
                <Button Content="Add" Command="{Binding AddCommand}" Style="{StaticResource Button.Primary}" Padding="14,7"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                <ListView ItemsSource="{Binding Variables}" behaviors:GridViewSort.AutoSort="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Scope" Width="80" DisplayMemberBinding="{Binding Scope}"
                                             behaviors:GridViewSort.PropertyName="Scope"/>
                            <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}"
                                             behaviors:GridViewSort.PropertyName="Name"/>
                            <GridViewColumn Header="Value" Width="400" DisplayMemberBinding="{Binding Value}"
                                             behaviors:GridViewSort.PropertyName="Value"/>
                            <GridViewColumn Header="" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:EnvironmentVariableEntry}">
                                        <Button Content="Delete" Style="{StaticResource Button.Destructive}" Padding="10,4"
                                                FontSize="{DynamicResource Font.Size.Small}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
