<UserControl x:Class="WinKit.UI.Views.SystemTools.ServicesManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinKit.UI.ViewModels.SystemTools"
             xmlns:models="clr-namespace:WinKit.SystemTools.Models;assembly=WinKit.SystemTools"
             d:DataContext="{d:DesignInstance vm:ServicesManagerViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Services.Count, StringFormat={}{0} services}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}" Padding="14,7"/>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <ListView ItemsSource="{Binding Services}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="320" DisplayMemberBinding="{Binding DisplayName}"/>
                            <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding Status}"/>
                            <GridViewColumn Header="Startup type" Width="110" DisplayMemberBinding="{Binding StartupType}"/>
                            <GridViewColumn Header="" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:ServiceEntry}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Start" Style="{StaticResource Button.Secondary}" Padding="10,4" Margin="0,0,6,0"
                                                    FontSize="{DynamicResource Font.Size.Small}" IsEnabled="{Binding CanStart}"
                                                    Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Stop" Style="{StaticResource Button.Destructive}" Padding="10,4"
                                                    FontSize="{DynamicResource Font.Size.Small}" IsEnabled="{Binding CanStop}"
                                                    Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
