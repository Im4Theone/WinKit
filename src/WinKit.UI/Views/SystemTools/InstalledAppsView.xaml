<UserControl x:Class="WinKit.UI.Views.SystemTools.InstalledAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinKit.UI.ViewModels.SystemTools"
             xmlns:behaviors="clr-namespace:WinKit.UI.Behaviors"
             d:DataContext="{d:DesignInstance vm:InstalledAppsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <!--
            A thin pulsing bar instead of a full marquee ProgressBar template - conveys
            "busy" without the visual weight of a wide loading bar in a narrow cell.
        -->
        <Style x:Key="BusyPulse" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Opacity" Value="0.35"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUninstalling}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                  From="0.35" To="1" Duration="0:0:0.6"
                                                  AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Apps.Count, StringFormat={}{0} applications}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}" Padding="14,7"/>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <ListView ItemsSource="{Binding Apps}" behaviors:GridViewSort.AutoSort="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="270" DisplayMemberBinding="{Binding App.Name}"
                                             behaviors:GridViewSort.PropertyName="App.Name"/>
                            <GridViewColumn Header="Publisher" Width="170" DisplayMemberBinding="{Binding App.Publisher}"
                                             behaviors:GridViewSort.PropertyName="App.Publisher"/>
                            <GridViewColumn Header="Version" Width="90" DisplayMemberBinding="{Binding App.Version}"
                                             behaviors:GridViewSort.PropertyName="App.Version"/>
                            <GridViewColumn Header="Size" Width="80" behaviors:GridViewSort.PropertyName="App.EstimatedSizeMb">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:InstalledAppItemViewModel}">
                                        <TextBlock Text="{Binding App.EstimatedSizeMb, Converter={StaticResource NullableMegabytesConverter}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:InstalledAppItemViewModel}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Uninstall" Style="{StaticResource Button.Destructive}" Padding="10,4"
                                                    FontSize="{DynamicResource Font.Size.Small}" IsEnabled="{Binding IsUninstalling, Converter={StaticResource InverseBooleanConverter}}"
                                                    Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"/>
                                            <Border Style="{StaticResource BusyPulse}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsUninstalling, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
