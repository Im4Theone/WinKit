<UserControl x:Class="WinKit.UI.Views.SystemTools.HostsFileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinKit.UI.ViewModels.SystemTools"
             d:DataContext="{d:DesignInstance vm:HostsFileViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding FilePath}" Style="{StaticResource Text.Secondary}"/>
                <TextBlock Text="Editing requires administrator access. Changes take effect immediately." Style="{StaticResource Text.Muted}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Reload" Command="{Binding LoadCommand}" Style="{StaticResource Button.Secondary}" Padding="14,7" Margin="0,0,8,0"/>
                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource Button.Primary}" Padding="14,7"/>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="0">
            <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Cascadia Mono, Consolas" Padding="14" Height="500"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0"/>
        </Border>
    </DockPanel>
</UserControl>
