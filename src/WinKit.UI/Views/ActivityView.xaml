<UserControl x:Class="WinKit.UI.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinKit.UI.ViewModels"
             xmlns:core="clr-namespace:WinKit.Core.Models;assembly=WinKit.Core"
             d:DataContext="{d:DesignInstance vm:ActivityViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,28,28">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="Activity" Style="{StaticResource Text.Display}"/>
            <TextBlock Text="Everything WinKit has done, most recent first." Style="{StaticResource Text.Secondary}" Margin="0,4,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="All" Command="{Binding ShowAllCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAllSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                    <Setter Property="BorderBrush" Value="Black"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Actions" Command="{Binding ShowActionsCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActionsSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                    <Setter Property="BorderBrush" Value="Black"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Themes &amp; Settings" Command="{Binding ShowThemesAndSettingsCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FilterButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsThemesAndSettingsSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                    <Setter Property="BorderBrush" Value="Black"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <ItemsControl x:Name="EntriesList" ItemsSource="{Binding FilteredEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:ActivityEntry}">
                                <Grid Margin="16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="6" Height="6" Margin="0,0,10,0" VerticalAlignment="Center"
                                             Fill="{DynamicResource Brush.TextMuted}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Base}"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}"
                                                   Visibility="{Binding Detail, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Timestamp, StringFormat={}{0:g}}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No activity in this category yet." Style="{StaticResource Text.Muted}" Margin="16,14"
                               Visibility="{Binding HasItems, ElementName=EntriesList, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
