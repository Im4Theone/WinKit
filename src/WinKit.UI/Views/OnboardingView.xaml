<UserControl x:Class="WinKit.UI.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinKit.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:OnboardingViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Background="{DynamicResource Brush.Background}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
            <TextBlock Text="WinKit" Style="{StaticResource Text.Display}" HorizontalAlignment="Center"/>
            <TextBlock Text="Welcome to WinKit" Style="{StaticResource Text.Secondary}"
                       HorizontalAlignment="Center" Margin="0,10,0,36"/>

            <TextBlock Text="What should we call you?" Style="{StaticResource Text.Title}" Margin="0,0,0,10"/>
            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Padding="12,10" FontSize="{DynamicResource Font.Size.Title}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding ContinueCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Button Content="Continue" Command="{Binding ContinueCommand}" Style="{StaticResource Button.Primary}"
                    HorizontalAlignment="Stretch" Padding="0,11" Margin="0,20,0,0" FontSize="{DynamicResource Font.Size.Title}"/>
        </StackPanel>
    </Grid>
</UserControl>
