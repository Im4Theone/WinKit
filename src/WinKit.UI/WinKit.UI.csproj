<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WinKit</AssemblyName>
    <RootNamespace>WinKit.UI</RootNamespace>
    <ApplicationIcon>Assets\Icon\WinKit.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>WinKit</AssemblyTitle>
    <Description>A lightweight Windows toolkit for system information, diagnostics, cleanup, and networking.</Description>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinKit.Core\WinKit.Core.csproj" />
    <ProjectReference Include="..\WinKit.Infrastructure\WinKit.Infrastructure.csproj" />
    <ProjectReference Include="..\WinKit.Themes\WinKit.Themes.csproj" />
    <ProjectReference Include="..\WinKit.System\WinKit.System.csproj" />
    <ProjectReference Include="..\WinKit.Network\WinKit.Network.csproj" />
    <ProjectReference Include="..\WinKit.Cleanup\WinKit.Cleanup.csproj" />
    <ProjectReference Include="..\WinKit.Diagnostics\WinKit.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icon\WinKit.ico" />
    <Resource Include="Assets\Icon\icon-64.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

</Project>
