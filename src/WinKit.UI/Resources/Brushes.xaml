<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Default (Midnight) brush values. WinKit.UI.Theming.ThemeApplier overwrites these
        entries at runtime in Application.Resources when the active theme changes, so every
        control that binds via DynamicResource repaints without a restart.
    -->

    <Color x:Key="Color.Background">#101012</Color>
    <Color x:Key="Color.Surface">#151517</Color>
    <Color x:Key="Color.SurfaceElevated">#1A1A1D</Color>
    <Color x:Key="Color.Border">#252529</Color>
    <Color x:Key="Color.TextPrimary">#F5F5F7</Color>
    <Color x:Key="Color.TextSecondary">#A1A1A8</Color>
    <Color x:Key="Color.TextMuted">#6F6F76</Color>
    <Color x:Key="Color.Accent">#4C8DFF</Color>
    <Color x:Key="Color.AccentHover">#669DFF</Color>
    <Color x:Key="Color.Success">#4ADE80</Color>
    <Color x:Key="Color.Warning">#FBBF24</Color>
    <Color x:Key="Color.Error">#F87171</Color>
    <Color x:Key="Color.Update">#53B3D4</Color>
    <Color x:Key="Color.OnAccent">#FFFFFF</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{DynamicResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="{DynamicResource Color.SurfaceElevated}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{DynamicResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{DynamicResource Color.AccentHover}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Error" Color="{DynamicResource Color.Error}"/>
    <SolidColorBrush x:Key="Brush.Update" Color="{DynamicResource Color.Update}"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{DynamicResource Color.OnAccent}"/>

    <!-- Layout tokens; overwritten per-theme alongside the brushes above. -->
    <CornerRadius x:Key="Theme.CornerRadius">6</CornerRadius>
    <CornerRadius x:Key="Theme.CornerRadiusSmall">4</CornerRadius>
    <GridLength x:Key="Theme.SidebarWidth">232</GridLength>

    <Duration x:Key="Anim.Duration.Fast">0:0:0.12</Duration>
    <Duration x:Key="Anim.Duration.Normal">0:0:0.16</Duration>

</ResourceDictionary>
