<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Simple line-drawn navigation icons, stroked (not filled) for a consistent, crisp look at 16x16. -->

    <PathGeometry x:Key="Icon.Dashboard" Figures="M1,1 H7 V7 H1 Z M9,1 H15 V7 H9 Z M1,9 H7 V15 H1 Z M9,9 H15 V15 H9 Z"/>
    <PathGeometry x:Key="Icon.System" Figures="M1,2 H15 V11 H1 Z M8,11 V13.5 M5,14 H11"/>
    <PathGeometry x:Key="Icon.Network" Figures="M1,10 H3.5 V14 H1 Z M5,7 H7.5 V14 H5 Z M9,4 H11.5 V14 H9 Z M13,1 H15 V14 H13 Z"/>
    <PathGeometry x:Key="Icon.Cleanup" Figures="M6,0.5 H10 V2 M3,2 H13 V3.5 H3 Z M4,4 L12,4 L11,15 L5,15 Z M7,6 V13 M9,6 V13"/>
    <PathGeometry x:Key="Icon.Diagnostics" Figures="M1,8 H4 L6,3 L8,13 L10,5 L11,8 H15"/>
    <PathGeometry x:Key="Icon.Settings" Figures="M1,3 H15 M4,1.2 V4.8 M1,8 H15 M10,6.2 V9.8 M1,13 H15 M6,11.2 V14.8"/>
    <PathGeometry x:Key="Icon.About" Figures="M2,2 H14 V14 H2 Z M8,5 L8,5.15 M8,7.3 V11.3"/>

    <PathGeometry x:Key="Icon.Minimize" Figures="M2,8 H14"/>
    <PathGeometry x:Key="Icon.Maximize" Figures="M2.5,2.5 H13.5 V13.5 H2.5 Z"/>
    <PathGeometry x:Key="Icon.Restore" Figures="M5,2.5 H13.5 V11 M2.5,5 H11 V13.5 H2.5 Z"/>
    <PathGeometry x:Key="Icon.Close" Figures="M2.5,2.5 L13.5,13.5 M13.5,2.5 L2.5,13.5"/>

    <Style x:Key="Icon.Path" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="1.3"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>

</ResourceDictionary>
