<Application x:Class="WinKit.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WinKit.UI.Converters"
             xmlns:sc="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <sc:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <conv:NullableMegabytesConverter x:Key="NullableMegabytesConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:BytesToReadableConverter x:Key="BytesToReadableConverter"/>
            <conv:DiagnosticStatusToBrushConverter x:Key="DiagnosticStatusToBrushConverter"/>
            <conv:ResourceKeyToGeometryConverter x:Key="ResourceKeyToGeometryConverter"/>
            <conv:ConnectedTextConverter x:Key="ConnectedTextConverter"/>
            <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
            <conv:FirstOrPlaceholderConverter x:Key="FirstOrPlaceholderConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
